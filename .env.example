# Copy to .env.local and fill in. The same variables go in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (Network Access must allow 0.0.0.0/0 for Vercel)
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/christmas-movies?retryWrites=true&w=majority"
MONGODB_DB=christmas-movies

# Fallback password for /admin until ADMIN_PASSWORD is set
APP_PASSWORD=

# Optional: separate password for /admin (invites, homes). Falls back to APP_PASSWORD
ADMIN_PASSWORD=

# Optional: maximum number of homes (default 25)
HOME_CAP=

# Secret for the crons (weekly cleanup and daily reminder; Vercel sends it as a bearer token): openssl rand -base64 32
CRON_SECRET=

# E-mail account that sends the welcome e-mail, the "forgot my password" code and the daily reminder.
# Gmail (no domain needed): smtp.gmail.com + an app password; the mail goes out authenticated by Google.
# Brevo (free, 300 a day): smtp-relay.brevo.com, port 587, the login and key from its SMTP & API page, but it
# needs a sender on YOUR OWN domain (with DKIM and DMARC); don't use an @gmail.com sender there.
# Without these, `pnpm dev` prints the e-mails in the terminal instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Random secret to sign the session cookie: openssl rand -base64 32
AUTH_SECRET=

# Optional: free key from https://www.omdbapi.com/apikey.aspx to fill missing IMDb / Rotten Tomatoes scores
OMDB_API_KEY=
