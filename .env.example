# Copy to .env.local and fill in. The same variables go in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (Network Access must allow 0.0.0.0/0 for Vercel)
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/christmas-movies?retryWrites=true&w=majority"
MONGODB_DB=christmas-movies

# The single password to enter the app
APP_PASSWORD=

# Random secret to sign the session cookie: openssl rand -base64 32
AUTH_SECRET=

# Optional: free key from https://www.omdbapi.com/apikey.aspx to fill missing IMDb / Rotten Tomatoes scores
OMDB_API_KEY=
